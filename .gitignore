# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Django stuff
*.log
*.pot
*.pyc
db.sqlite3
media/
staticfiles/

# Environment files
.env
.env.*

# VS Code settings
.vscode/

# Mac system files
.DS_Store

# Python virtual environments
venv/
env/
ENV/

# Coverage reports
htmlcov/
.coverage
coverage.xml
*.cover

# Pytest
.pytest_cache/

# Migrations (optional - if you want to auto-generate later)
**/migrations/*.py
!**/migrations/__init__.py

# Node (if using React or JS tools)
node_modules/

# Build files
dist/
build/

# Other
*.swp
*.bak
*.tmp
